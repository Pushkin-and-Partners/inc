<script>
  // меню: прозрачное поверх фото, кремовое после прокрутки хиро
  var navEl = document.querySelector('.nav');
  var heroEl = document.getElementById('top');
  function syncNav(){
    navEl.classList.toggle('nav--solid', window.scrollY > heroEl.offsetHeight - 90);
  }
  window.addEventListener('scroll', syncNav, { passive:true });
  window.addEventListener('resize', syncNav);
  syncNav();

  /* =========================================================
     ОТЗЫВЫ
     Форма подключена к базе Supabase — отзывы сохраняются
     и видны всем. Ключ ниже публичный, его можно держать в коде:
     он позволяет только читать и добавлять записи, не удалять.
     Удалять отзывы — в панели Supabase, таблица testimonials.
     ========================================================= */
  var SUPABASE_URL = 'https://bbkikfhmklmiunsmhfyc.supabase.co';
  var SUPABASE_KEY = 'sb_publishable_5LLB05h786riEtEDZ_hX7g_I9X_MWqL';

  var LIVE = SUPABASE_URL !== '' && SUPABASE_KEY !== '';
  var demoList = [];

  var grid     = document.querySelector('.testimonials-grid');
  var nameEl   = document.getElementById('t-name');
  var roleEl   = document.getElementById('t-role');
  var bodyEl   = document.getElementById('t-body');
  var submitEl = document.getElementById('t-submit');
  var statusEl = document.getElementById('t-status');

  function initials(name){
    return name.trim().split(/\s+/).slice(0,2).map(function(w){
      return w.charAt(0).toUpperCase();
    }).join('');
  }

  function escapeHtml(str){
    var d = document.createElement('div');
    d.textContent = str;
    return d.innerHTML;
  }

  function renderOne(t){
    var card = document.createElement('div');
    card.className = 'testimonial is-visible';
    card.innerHTML =
      '<p class="quote">' + escapeHtml(t.body) + '</p>' +
      '<div class="testimonial-who">' +
        '<div class="testimonial-avatar">' + escapeHtml(initials(t.name)) + '</div>' +
        '<div><div class="testimonial-name">' + escapeHtml(t.name) + '</div>' +
        '<div class="testimonial-role">' + escapeHtml(t.role) + '</div></div>' +
      '</div>';
    grid.insertBefore(card, grid.firstChild);
  }

  function loadTestimonials(){
    if(!LIVE){ return; }
    fetch(SUPABASE_URL + '/rest/v1/testimonials?select=*&order=created_at.asc', {
      headers: { apikey: SUPABASE_KEY, Authorization: 'Bearer ' + SUPABASE_KEY }
    })
    .then(function(r){ return r.ok ? r.json() : []; })
    .then(function(rows){ rows.forEach(renderOne); })
    .catch(function(){ /* тихо: секция остаётся с готовыми отзывами */ });
  }

  submitEl.addEventListener('click', function(){
    var t = {
      name: nameEl.value.trim(),
      role: roleEl.value.trim(),
      body: bodyEl.value.trim()
    };
    if(!t.name || !t.role || !t.body){
      statusEl.textContent = 'Please fill in all three fields.';
      return;
    }

    submitEl.disabled = true;
    statusEl.textContent = 'Submitting…';

    function done(){
      renderOne(t);
      nameEl.value = roleEl.value = bodyEl.value = '';
      submitEl.disabled = false;
      statusEl.textContent = LIVE
        ? 'Thank you. Your testimonial is now published.'
        : 'Published locally — visible in this tab only until Supabase is connected.';
    }

    if(!LIVE){ demoList.push(t); done(); return; }

    fetch(SUPABASE_URL + '/rest/v1/testimonials', {
      method: 'POST',
      headers: {
        apikey: SUPABASE_KEY,
        Authorization: 'Bearer ' + SUPABASE_KEY,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(t)
    })
    .then(function(r){
      if(!r.ok) throw new Error();
      done();
    })
    .catch(function(){
      submitEl.disabled = false;
      statusEl.textContent = 'Could not submit. Please try again.';
    });
  });

  loadTestimonials();

  // карусель команды
  var track = document.getElementById('team-track');
  var prevBtn = document.getElementById('team-prev');
  var nextBtn = document.getElementById('team-next');
  function step(){
    var card = track.querySelector('.employee');
    return card ? card.getBoundingClientRect().width + 1 : 300;
  }
  function syncArrows(){
    prevBtn.disabled = track.scrollLeft < 8;
    nextBtn.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 8;
  }
  prevBtn.addEventListener('click', function(){ track.scrollLeft -= step(); });
  nextBtn.addEventListener('click', function(){ track.scrollLeft += step(); });
  track.addEventListener('scroll', syncArrows, { passive:true });
  window.addEventListener('resize', syncArrows);
  syncArrows();

  // портреты в отзывах берутся из карточек раздела Our Team
  document.querySelectorAll('.testimonial[data-employee]').forEach(function(item){
    var who = item.getAttribute('data-employee');
    var match = null;
    document.querySelectorAll('.team-track .employee').forEach(function(card){
      var nameEl = card.querySelector('.employee-name');
      if(nameEl && nameEl.textContent.trim() === who) match = card;
    });
    if(!match) return;
    var src = match.querySelector('.employee-photo img');
    var slot = item.querySelector('.testimonial-avatar');
    if(src && slot){
      var copy = document.createElement('img');
      copy.src = src.src;
      copy.alt = '';
      slot.textContent = '';
      slot.appendChild(copy);
    }
  });

  var revealEls = document.querySelectorAll('.reveal');
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){ e.target.classList.add('is-visible'); io.unobserve(e.target); }
    });
  }, { threshold: 0.12 });
  revealEls.forEach(function(el){ io.observe(el); });

  /* =========================================================
     КАПИТАЛ КОМПАНИИ — МЕНЯТЬ ЗДЕСЬ
     Поменяй два числа ниже и сохрани файл.
     Количество сотрудников считается само по разделу Our Team —
     руками его менять не нужно.
     ========================================================= */
  var CAPITAL_CURRENT = 8888;   // текущая сумма, ₽
  var CAPITAL_TARGET  = 500000; // цель, ₽

  var EMPLOYEE_COUNT = document.querySelectorAll('.team-track .employee:not(.employee-open)').length;
  document.getElementById('cap-employees').textContent = EMPLOYEE_COUNT;

  // кружки с инициалами берутся из первых трёх карточек в разделе Our Team
  var cards = document.querySelectorAll('.team-track .employee:not(.employee-open)');
  document.querySelectorAll('.funding-count').forEach(function(el){
    el.textContent = EMPLOYEE_COUNT;
  });
  document.querySelectorAll('.avatar-stack').forEach(function(stack){
    Array.prototype.slice.call(cards, 0, 3).forEach(function(card){
      var slot = document.createElement('span');
      var photo = card.querySelector('.employee-photo');
      var img = photo ? photo.querySelector('img') : null;
      if(img){
        var copy = document.createElement('img');
        copy.src = img.src;
        copy.alt = '';
        slot.appendChild(copy);
      } else if(photo){
        slot.textContent = photo.textContent.trim();
      }
      stack.appendChild(slot);
    });
  });

  var capEl = document.getElementById('cap-current');
  var fillEl = document.getElementById('cap-fill');
  var capitalAnimated = false;

  function animateCapital(){
    if(capitalAnimated) return;
    capitalAnimated = true;
    var pct = Math.min(100, (CAPITAL_CURRENT / CAPITAL_TARGET) * 100);
    fillEl.style.width = pct + '%';
    var dur = 900, start = performance.now();
    function step(now){
      var t = Math.min(1, (now - start) / dur);
      capEl.textContent = '₽' + Math.round(CAPITAL_CURRENT * t).toLocaleString('en-US');
      if(t < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  var capIo = new IntersectionObserver(function(entries){
    entries.forEach(function(e){ if(e.isIntersecting){ animateCapital(); capIo.disconnect(); } });
  }, { threshold: 0.3 });
  capIo.observe(document.getElementById('company'));
</script>

